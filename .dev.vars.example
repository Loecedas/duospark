# ========================================================
# 🦉 Cloudflare Workers / Wrangler 本地预览环境变量模版
# 使用说明：复制本文件为 .dev.vars 并填入您的真实凭证
# 在 Cloudflare 线上部署时，请在 Cloudflare Dashboard 的
# Settings -> Variables and Secrets (环境变量) 中添加这些变量
# ========================================================

NEXTJS_ENV=development

# 1. 多邻国 JWT Token (从浏览器 Cookies 中的 jwt_token 获取)
DUO_JWT_TOKEN=

# 2. 飞书自建应用配置 (从飞书开放平台获取)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 3. 飞书接收人 (选填：留空将自动推送给应用管理员，也可填手机号或邮箱)
FEISHU_RECEIVE_PHONE_OR_EMAIL=
