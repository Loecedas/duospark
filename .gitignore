# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build

# Runtime database & sensitive user credentials (strictly ignored)
/data/*
!/data/.gitkeep
!/data/config.example.json

# Operating System & Editors
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# Debug and Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Sensitive Environment files (strictly ignored)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Next.js auto-generated agent rules (ignore from Git)
AGENTS.md

# Temporary script exports
scripts/export_info.txt

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
