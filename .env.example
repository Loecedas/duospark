# ========================================================
# 🦉 多邻国连胜守护系统 - 环境变量配置模版
# 使用说明：复制本文件为 .env.local 并填入您的真实凭证
# ========================================================

# 1. 多邻国 JWT Token (从浏览器 Cookies 中的 jwt_token 获取)
DUO_JWT_TOKEN=your_duolingo_jwt_token_here

# 2. 飞书自建应用配置 (从飞书开放平台获取)
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 3. 飞书接收人 (选填：留空将自动解析并推送给当前应用管理员，也可填手机号或邮箱)
FEISHU_RECEIVE_PHONE_OR_EMAIL=
